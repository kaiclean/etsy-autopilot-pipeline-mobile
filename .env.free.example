# Copy to .env.box on the Mac; keep mode 600 and never commit the copy.
# Netlify needs the shared database/storage/auth values and execution flags.
# Provider credentials and the local Ollama endpoint belong on the box only.
AUTOPILOT_EXECUTION=box
FREE_ONLY_MODE=true
PUBLISH_MODE=dry-run
DEMO_MODE=false
APP_URL=https://YOUR-SITE.netlify.app
DATABASE_URL=
DASHBOARD_PASSWORD=
AUTH_SECRET=
CRON_SECRET=
ETSY_SHOP_ID=
ETSY_API_KEY=
ETSY_SHARED_SECRET=
ETSY_REDIRECT_URI=https://YOUR-SITE.netlify.app/api/etsy/oauth/callback
# Optional POD connection; leave unset when launching digital downloads only.
PRINTIFY_API_TOKEN=
PRINTIFY_SHOP_ID=
PRINTIFY_WEBHOOK_SECRET=

# Supabase Storage's S3 endpoint, from project Settings → Storage.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_ENDPOINT_URL_S3=https://YOUR-PROJECT.storage.supabase.co/storage/v1/s3
AWS_REGION=
S3_BUCKET=artwork
SUPABASE_STORAGE_PLAN=free
S3_URL_MODE=stable
S3_FORCE_PATH_STYLE=true
# Leave unset for a private bucket through public, unguessable app media URLs.
# Those URLs are bearer links, not authenticated per-buyer access.
# Only use a public base URL if every object there may be publicly downloaded.
S3_PUBLIC_BASE_URL=

# Box-only provider settings. This declaration is checked by the app; it cannot
# inspect your provider subscription. Keep the actual Cloudflare plan Free.
IMAGE_PROVIDER=cloudflare
IMAGE_FALLBACK_PROVIDER=
CLOUDFLARE_WORKERS_PLAN=free
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_IMAGE_MODEL=@cf/black-forest-labs/flux-1-schnell
LLM_PROVIDER=ollama-local
OLLAMA_LOCAL_BASE_URL=http://127.0.0.1:11434/v1
OLLAMA_LOCAL_MODEL=
OLLAMA_LOCAL_VISION_MODEL=

# The web deployment is pull-only and never loads the model. The new box worker
# explicitly overrides these locally to run upscales inline. Do not start the
# legacy workers/upscaler/pull.ts alongside the main box worker.
UPSCALER_PULL=on
UPSCALER_SECRET=
BOX_IDLE_POLL_MS=900000
# Optional explicit local shop UUID; unset selects the active shop.
BOX_SHOP_ID=

# Leave durable Etsy event polling off until its queue has been separately
# configured and measured; continuous DB polling can exhaust Neon Free.
ETSY_EVENTS_ENABLED=false
ETSY_WEBHOOK_ENABLED=false
