{
  "name": "etsy-autopilot",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 4317",
    "build": "next build",
    "start": "next start -p 4317",
    "lint": "eslint",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:seed": "tsx src/db/seed-cli.ts",
    "db:clear-fake-orders": "tsx src/db/clear-fake-orders.ts",
    "images:backfill": "tsx src/db/backfill-image-urls.ts",
    "backfill:etsy-ids": "tsx src/pipeline/backfill-etsy-ids.ts",
    "vapid:generate": "node scripts/generate-vapid-keys.mjs",
    "designs:assess": "tsx src/db/reassess-designs.ts",
    "printify:catalog": "tsx src/adapters/printify/catalog-cli.ts",
    "etsy:types": "openapi-typescript data/etsy-openapi.snapshot.json --output src/adapters/etsy/generated.ts",
    "etsy:contract:check": "openapi-typescript data/etsy-openapi.snapshot.json --output /tmp/etsy-openapi-generated.ts && diff -u src/adapters/etsy/generated.ts /tmp/etsy-openapi-generated.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1143.0",
    "@aws-sdk/s3-request-presigner": "^3.1143.0",
    "@base-ui/react": "^1.8.0",
    "@electric-sql/pglite": "^0.5.8",
    "@neondatabase/serverless": "^1.1.0",
    "@opentelemetry/api": "1.9.1",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tabs": "^1.1.21",
    "@vercel/blob": "^2.8.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.4.0",
    "date-fns": "^4.4.0",
    "drizzle-kit": "^0.31.11",
    "drizzle-orm": "^0.45.3",
    "google-trends-api": "^4.9.2",
    "lucide-react": "^1.48.0",
    "next": "16.3.6",
    "next-themes": "^0.4.6",
    "pg-boss": "12.38.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "recharts": "^3.8.0",
    "shadcn": "^4.21.0",
    "sharp": "0.35.5",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22.20.4",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/web-push": "^3.6.4",
    "dotenv": "^18.0.4",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "openapi-typescript": "7.13.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.2"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
