# Download a private filled-in copy at /brain/setup, then chmod 600 .env.brain.
BRAIN_BASE_URL=https://YOUR-SITE.netlify.app
BRAIN_SYNC_TOKEN=
INSTAGRAM_USERNAME=
# Optional custom path; otherwise Instaloader uses its standard local session.
INSTAGRAM_SESSION_FILE=
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gemma3:4b
WHISPER_MODEL=base
BRAIN_DAILY_HOUR=7
BRAIN_DAILY_MINUTE=20
BRAIN_MAX_REELS=12
BRAIN_SCAN_LIMIT=200
# Optional private persistent state path; keep it when updating the checkout.
BRAIN_DATA_DIR=
