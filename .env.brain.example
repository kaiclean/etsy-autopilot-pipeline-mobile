# Download a private filled-in copy at /brain/setup, then chmod 600 .env.brain.
APP_URL=https://etsy-autopilot-production-8b9f.up.railway.app
BRAIN_SYNC_TOKEN=
INSTAGRAM_USERNAME=
# Optional custom path; otherwise Instaloader uses its standard local session.
INSTAGRAM_SESSION_FILE=
# Optional one-time import when the session file is absent: chrome or chrome:/path/to/profile.
INSTAGRAM_COOKIES_FROM=
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gemma3:4b
WHISPER_MODEL=base
BRAIN_RUN_TIMES=07:20,19:20
BRAIN_MAX_REELS=12
BRAIN_SCAN_LIMIT=200
# Optional private persistent state path; keep it when updating the checkout.
BRAIN_DATA_DIR=
