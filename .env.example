# Etsy Autopilot: environment variables
# Copy to .env.local for local dev, or add in Vercel → Project → Settings → Environment Variables.
# Every variable is optional for local demo mode. Nothing is ever read from the database or UI as a secret.

# ── Dashboard auth (REQUIRED in production) ──────────────────────────────────────
# Password to unlock the dashboard. Local dev falls back to "autopilot" when unset.
DASHBOARD_PASSWORD=
# Random 32+ char string used to sign session cookies:  openssl rand -base64 32
AUTH_SECRET=
# Vercel Cron sends "Authorization: Bearer $CRON_SECRET" to /api/cron/*. Required in production.
CRON_SECRET=
# Public URL of the deployment (used to build absolute image URLs for Etsy/Printify uploads)
APP_URL=http://localhost:4317

# ── Database ────────────────────────────────────────────────────────────
# Neon Postgres connection string. When empty, an embedded PGlite database is used (./.data/pglite).
DATABASE_URL=

# ── Fees and FX ──────────────────────────────────────────────────────────────
# USD→CHF for the USD 0.20 listing fee, the USD 100 Offsite Ads cap, and fallback POD costs.
# When unset, the app uses the 24 Sep 2026 ECB reference (0.8278). This does not change live Etsy prices.
# USD_TO_CHF=0.8278
# USD_TO_CHF_AS_OF=2026-10-05
# Analytics stores a newer ECB rate from frankfurter.app when this is true. No Etsy pages are fetched.
# FX_REFRESH=false
# Destination VAT added to the processing base when suggesting prices.
# 0 (default) matches a buyer outside Switzerland. Orders to CH use the tax on the receipt.
# BUYER_TAX_RATE_ASSUMPTION=0

# ── Mode switches ───────────────────────────────────────────────────────────
# Demo mode shows seeded demo rows + DEMO badge. Auto: on until Etsy keys exist. Force with true/false.
DEMO_MODE=
# Leave this at dry-run. Live writes turn on from Connections → Go live
# after the checkbox and typing CONFIRM. This variable alone does not publish.
# Webhooks and image uploads still run; they do not publish listings.
PUBLISH_MODE=dry-run

# ── Etsy Open API v3 ─────────────────────────────────────────────────────────
# From https://www.etsy.com/developers/your-apps  (Keystring + Shared secret)
ETSY_API_KEY=
ETSY_SHARED_SECRET=
# Numeric shop id (GET /v3/application/users/{user_id}/shops after OAuth, or from Shop Manager URLs)
ETSY_SHOP_ID=
# Must exactly match a callback URL registered on the Etsy app
ETSY_REDIRECT_URI=http://localhost:4317/api/etsy/oauth/callback
# Seller taxonomy ids used for new drafts (GET /v3/application/seller-taxonomy/nodes)
ETSY_TAXONOMY_ID_DIGITAL=2078
ETSY_TAXONOMY_ID_POSTER=2078

# ── Printify ────────────────────────────────────────────────────────────────────
# Personal access token: Printify → My profile → Connections → API tokens
PRINTIFY_API_TOKEN=
# GET https://api.printify.com/v1/shops.json → id of the shop connected to Etsy
PRINTIFY_SHOP_ID=
# Product template: GET /v1/catalog/blueprints.json, then /blueprints/{id}/print_providers/{pid}/variants.json
# Required before a live product is created. The catalog provider is not auto-selected.
# One triple is used for every live POD preset. Record a physical sample for that pair in the app before Publish to Etsy.
PRINTIFY_BLUEPRINT_ID=
PRINTIFY_PRINT_PROVIDER_ID=
PRINTIFY_VARIANT_IDS=
# Shared secret sent when you create each Printify webhook (field "secret").
# Printify signs the raw body and sends sha256=<hex> in x-pfy-signature.
# Required in production for the webhook. Callback: POST $APP_URL/api/webhooks/printify
# After a human Publish to Etsy, the orders stage GETs /v1/shops/{id}/products/{id}.json
# for external.id on status=publishing rows. pod_created rows are not polled. No extra variable.
# Register one webhook per topic (order:created, order:updated, order:sent-to-production,
# order:shipment:created, order:shipment:delivered, product:publish:started) to that same URL.
PRINTIFY_WEBHOOK_SECRET=

# ── Image generation ────────────────────────────────────────────────────────────
# mock | higgsfield | openai | replicate
IMAGE_PROVIDER=mock
# Higgsfield platform API (cloud.higgsfield.ai → API keys). Verify endpoint paths for your plan.
HIGGSFIELD_API_KEY=
HIGGSFIELD_API_SECRET=
HIGGSFIELD_API_BASE=https://platform.higgsfield.ai
HIGGSFIELD_TEXT2IMAGE_PATH=/v1/text2image/soul
HIGGSFIELD_COST_PER_IMAGE_CHF=0.05
# Replicate alternative
REPLICATE_API_TOKEN=
REPLICATE_MODEL=black-forest-labs/flux-schnell

# ── Listing writer (LLM) + OpenAI-compatible images ───────────────────────────
# mock | openai   (openai also requires OPENAI_API_KEY)
# OPENAI_BASE_URL defaults to https://api.openai.com/v1.
# OpenRouter: OPENAI_BASE_URL=https://openrouter.ai/api/v1 and an OpenRouter key in OPENAI_API_KEY.
# OpenRouter image example: OPENAI_IMAGE_MODEL=google/gemini-2.5-flash-image
LLM_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_IMAGE_MODEL=gpt-image-1

# ── Research ──────────────────────────────────────────────────────────────────
# Google Trends via the unofficial endpoint (often rate-limited; falls back to seed scores)
RESEARCH_GOOGLE_TRENDS=true
# Extra keywords without a deploy: "niche:phrase|demand|competition;..."  niches: alpine gothic christmas birthday stream
KEYWORD_SEEDS=
# Etsy demand. Do not scrape etsy.com search or autocomplete (API Terms).
# Search volume: a Marketplace Insights-style CSV you export yourself, or the committed fixture.
# ETSY_DEMAND_SOURCE=fixture
# ETSY_INSIGHTS_PATH=/path/to/etsy-insights.csv
# ETSY_INSIGHTS_CSV="keyword,search_volume,competition,niche\ncozy christmas mug,8400,0.62,christmas"
# Competition counts: official Open API v3 GET /v3/application/listings/active (needs ETSY_API_KEY).
# ETSY_API_COMPETITION=false

# ── Web Push (VAPID) ──────────────────────────────────────────────────────────
# Generate with: npm run vapid:generate
# Subject must be a mailto: or https: URL. Keys are never stored in the database.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# ── Generated image storage ───────────────────────────────────────────────────
# S3-compatible (Railway bucket, AWS, R2, MinIO) is preferred. When these are set,
# image bytes are uploaded and the database stores a URL instead of a data URL.
# Railway typically provides AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY,
# AWS_ENDPOINT_URL_S3 (or AWS_ENDPOINT_URL), and AWS_REGION / AWS_DEFAULT_REGION.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_ENDPOINT_URL_S3=
AWS_REGION=auto
# Bucket name. Also read from AWS_S3_BUCKET_NAME or AWS_BUCKET_NAME.
S3_BUCKET=
# Optional public origin, no trailing slash, e.g. https://<bucket>.storage.railway.app
# When unset, the app stores $APP_URL/api/media/<key> and streams the private object.
S3_PUBLIC_BASE_URL=
# stable (default) or signed (7-day presigned GET URL stored in the database)
S3_URL_MODE=stable
# Path-style addressing for Railway/R2/MinIO. Set false for virtual-hosted AWS.
S3_FORCE_PATH_STYLE=true
# Used only when the S3 variables above are incomplete.
BLOB_READ_WRITE_TOKEN=
